<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b0b0e">
<title>公演サイトメーカー</title>
<style>
*{box-sizing:border-box}html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif;background:#0b0b0e;color:#f6f4ef;line-height:1.75}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.wrap{width:min(1080px,calc(100% - 36px));margin:auto}.top{position:fixed;z-index:50;top:0;left:0;right:0;height:60px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;background:#0b0b0ed8;backdrop-filter:blur(14px);border-bottom:1px solid #ffffff14}.top a{font-size:12px}.brand{font-weight:900}.badge{font-size:10px;padding:7px 10px;border:1px solid #ffffff24;border-radius:999px}.intro{padding:115px 0 40px}.intro small,.eyebrow{font-size:11px;letter-spacing:.17em;opacity:.65}.intro h1{margin:12px 0 18px;font-size:clamp(46px,12vw,105px);line-height:.9;letter-spacing:-.07em}.intro p{max-width:720px;color:#aaa;font-size:14px}.cards{display:grid;gap:16px;padding-bottom:80px}.card{position:relative;min-height:440px;border:1px solid #ffffff18;border-radius:28px;overflow:hidden;padding:25px;display:flex;align-items:flex-end}.cardIn{position:relative;z-index:4;max-width:650px}.card .n{font-size:10px;letter-spacing:.16em;opacity:.6}.card h2{margin:7px 0 12px;font-size:clamp(50px,13vw,105px);line-height:.82;letter-spacing:-.07em}.card h3{font-size:17px;margin:0 0 8px}.card p{font-size:13px;margin:0 0 16px;color:#d0cfd5}.pill{display:inline-block;padding:10px 13px;border-radius:999px;border:1px solid #ffffff30;background:#1119;font-size:11px;backdrop-filter:blur(8px)}
.reveal{background:#030304}.reveal:before{content:"";position:absolute;width:330px;height:330px;border-radius:50%;right:8%;top:14%;background:radial-gradient(circle,#fff9 0,#fff3 26%,transparent 68%);filter:blur(5px);animation:beam 5s ease-in-out infinite alternate}@keyframes beam{to{transform:translate(-38vw,25vh) scale(.75)}}
.flow{background:#07102f}.flow:before,.flow:after{content:"";position:absolute;width:125vw;height:58vh;left:-15vw;border-radius:49% 51% 56% 44%/58% 46% 54% 42%;mix-blend-mode:screen}.flow:before{top:-18vh;background:linear-gradient(90deg,#6253ff,#00d7ff);animation:f1 6s ease-in-out infinite alternate}.flow:after{bottom:-24vh;background:linear-gradient(90deg,#ff4f99,#784cff);animation:f2 7s ease-in-out infinite alternate}@keyframes f1{to{transform:translate(14vw,28vh) rotate(15deg)}}@keyframes f2{to{transform:translate(-14vw,-24vh) rotate(-13deg)}}
.type{background:#eeeade;color:#111}.type:before{content:"ことばが\A舞台になる。";white-space:pre;position:absolute;left:4%;top:8%;font-family:Georgia,"Yu Mincho",serif;font-size:clamp(68px,20vw,205px);line-height:.83;letter-spacing:-.09em;color:#1112}.type p{color:#333}.type .pill{color:#111;border-color:#1112;background:#fff8}
.poster{background:#111116}.poster:before{content:"";position:absolute;width:min(70vw,570px);aspect-ratio:3/4;right:-4%;top:2%;background:linear-gradient(145deg,#ffd22f 0 43%,#ff4d6d 43% 70%,#f5efe0 70%);transform:rotate(8deg);box-shadow:0 30px 90px #000a}.poster:after{content:"PLAY\A2026";white-space:pre;position:absolute;right:4%;top:10%;font:900 clamp(46px,12vw,110px)/.8 -apple-system,sans-serif;letter-spacing:-.08em;color:#111}
.quiet{background:#f0ede5;color:#111}.quiet:before{content:"";position:absolute;right:10%;top:15%;width:34%;height:38%;background:linear-gradient(145deg,#d6d2c7,#b8b4aa)}.quiet:after{content:"";position:absolute;right:6%;top:11%;height:65%;width:1px;background:#1113}.quiet p{color:#333}.quiet .pill{color:#111;border-color:#1112;background:#fff8}
.hero{min-height:82svh;padding:105px 20px 55px;position:relative;overflow:hidden;display:flex;align-items:flex-end}.heroIn{position:relative;z-index:4;width:min(1080px,100%);margin:auto}.hero h1{margin:10px 0 14px;font-size:clamp(55px,15vw,130px);line-height:.84;letter-spacing:-.075em}.hero h2{margin:0 0 9px;font-size:19px}.hero p{max-width:680px;font-size:14px;color:#c9c8cd;margin:0}.hero.type p,.hero.quiet p{color:#333}.back{display:inline-flex;margin-top:23px;font-size:11px;padding:9px 12px;border:1px solid currentColor;border-radius:999px;opacity:.8}.section{padding:52px 0 82px}.section h3{font-size:31px;line-height:1.2;letter-spacing:-.04em;margin:0 0 8px}.lead{font-size:13px;color:#aaa;margin:0 0 20px}.guide{padding:18px;border:1px solid #ffffff17;border-radius:20px;background:#151518;margin-bottom:22px}.guide strong{font-size:14px}.guide p{margin:7px 0 0;font-size:12px;color:#aaa}.ex{display:inline-block;padding:1px 7px;background:#ffffff0c;border-radius:7px;color:#eee}.form{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:grid;gap:6px}.full{grid-column:1/-1}.field label{font-size:12px;font-weight:800}.field small{font-size:11px;color:#85858c}.field input,.field textarea{width:100%;border:1px solid #ffffff1a;background:#17171b;color:#fff;border-radius:14px;padding:14px 15px;outline:none}.field textarea{min-height:115px;resize:vertical}.make{grid-column:1/-1;border:0;border-radius:16px;padding:17px 18px;background:#f4f2ed;color:#111;font-weight:900;margin-top:8px}.preview{display:none;margin-top:40px;border-radius:28px;overflow:hidden;border:1px solid #ffffff1b}.preview.show{display:block}.stage{position:relative;min-height:92svh;padding:80px 24px 55px;display:flex;align-items:flex-end;overflow:hidden}.stageIn{position:relative;z-index:4;width:min(900px,100%);margin:auto}.stage .org{font-size:11px;letter-spacing:.15em;opacity:.65}.stage .title{margin:8px 0 13px;font-size:clamp(48px,14vw,112px);line-height:.88;letter-spacing:-.065em}.stage .catch{font-size:17px;font-weight:800;margin-bottom:25px}.info{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0 0 24px}.info div{border-top:1px solid currentColor;padding-top:8px}.info b{display:block;font-size:10px;letter-spacing:.08em}.info span{font-size:13px;white-space:pre-line}.story{max-width:720px;font-size:13px;white-space:pre-line}.ticket{display:inline-block;margin-top:23px;padding:13px 17px;border-radius:999px;background:#f4f2ed;color:#111;font-weight:900;font-size:12px}.stage.type .ticket,.stage.quiet .ticket{background:#111;color:#fff}.foot{padding:35px 20px 60px;text-align:center;color:#666;font-size:11px;border-top:1px solid #ffffff10}
@media(max-width:640px){.form{grid-template-columns:1fr}.full,.make{grid-column:auto}.info{grid-template-columns:1fr}.card{min-height:470px}.hero{min-height:84svh}.stage{min-height:88svh}}
</style>
</head>
<body>
<header class="top"><a class="brand" href="?">公演サイトメーカー</a><span class="badge">試作版</span></header>
<div id="app"></div>
<script>
const T={
reveal:{name:'REVEAL',jp:'隠れたものが現れる',desc:'暗い画面の中から、光が当たった場所だけ言葉やビジュアルが現れます。ミステリー、幻想、ホラーなど、最初から世界観に引き込みたい公演向け。'},
flow:{name:'FLOW',jp:'画面そのものが流れて変わる',desc:'色や形が画面を横切り、場面転換のように情報が切り替わります。ダンス、音楽劇、抽象的な作品など、動きや勢いを見せたい公演向け。'},
type:{name:'TYPE',jp:'言葉そのものを舞台にする',desc:'大きな文字が現れたり、重なったり、離れたりします。写真が少なくても、タイトルや台詞を主役にして強い印象を作れます。'},
poster:{name:'POSTER',jp:'フライヤーをサイトの主役にする',desc:'公演フライヤーの色や構成をそのままサイトの中心にして見せます。すでに作った宣伝ビジュアルを最大限活かしたい公演向け。'},
quiet:{name:'QUIET',jp:'静かに、上品に見せる',desc:'余白、大きな文字、一枚の写真を中心に、動きを抑えて見せます。会話劇、文芸作品、写真や美術を丁寧に見せたい公演向け。'}
};
const q=new URLSearchParams(location.search),mode=q.get('view');

function home(){
app.innerHTML=`<main class="wrap"><section class="intro"><small>舞台・公演向け</small><h1>作品に合う<br>見せ方を選ぶ。</h1><p>公演情報を入れるだけで、作品の空気に合わせたサイトを作るための試作です。気になる見せ方を押すと、その演出専用ページへ移動します。</p></section><section class="cards">${Object.entries(T).map(([k,t],i)=>`<a class="card ${k}" href="?view=${k}"><div class="cardIn"><div class="n">0${i+1}</div><h2>${t.name}</h2><h3>${t.jp}</h3><p>${t.desc}</p><span class="pill">この見せ方を開く →</span></div></a>`).join('')}</section></main><footer class="foot">公演情報を入力しても、ここでは公開されません。</footer>`
}

function tpl(k){
const t=T[k];
app.innerHTML=`<main><section class="hero ${k}"><div class="heroIn"><div class="eyebrow">${t.name}</div><h1>${t.name}</h1><h2>${t.jp}</h2><p>${t.desc}</p><a class="back" href="?">← 5つの見せ方へ戻る</a></div></section><section class="section"><div class="wrap"><h3>公演情報を入れる</h3><p class="lead">まずは分かるところだけでOK。入力した内容を下の完成イメージに反映します。</p><div class="guide"><strong>書き方は自由です。</strong><p>日程は <span class="ex">2026/1/1 19:00</span> のような書き方でOK。複数ある場合は改行して入力できます。</p><p>出演者も一人ずつ改行すれば、そのまま見やすく表示します。</p></div><form class="form" id="f"><div class="field"><label>公演タイトル</label><input name="title" placeholder="例：夜明けを待つ部屋" required></div><div class="field"><label>団体名</label><input name="org" placeholder="例：劇団サンプル"></div><div class="field full"><label>一言紹介</label><input name="catch" placeholder="例：あなたが忘れた夜の話。"></div><div class="field"><label>公演日時</label><textarea name="date" placeholder="例：2026/1/1 19:00&#10;2026/1/2 13:00"></textarea><small>西暦/月/日 時刻くらいの簡単な入力でOK。</small></div><div class="field"><label>会場</label><textarea name="venue" placeholder="例：東京 ○○スタジオ"></textarea></div><div class="field"><label>料金</label><input name="price" placeholder="例：前売 3,000円 / 当日 3,500円"></div><div class="field"><label>予約ページ</label><input name="url" placeholder="例：https://..."></div><div class="field full"><label>出演者</label><textarea name="cast" placeholder="例：山田花子&#10;佐藤太郎&#10;鈴木一郎"></textarea><small>一人ずつ改行すると見やすくなります。</small></div><div class="field full"><label>あらすじ</label><textarea name="story" placeholder="例：ある冬の夜、ひとりの男が誰もいない駅に降り立つ。そこには、忘れたはずの記憶が待っていた。"></textarea></div><button class="make" type="submit">この内容で完成イメージを見る</button></form><section class="preview" id="pv"></section></div></section></main>`;
document.querySelector('#f').addEventListener('submit',e=>{
e.preventDefault();
const d=Object.fromEntries(new FormData(e.target));
renderPreview(k,d)
})
}

function fmtDate(s){
return s.split('\n').map(x=>x.trim().replace(/(\d{4})\/(\d{1,2})\/(\d{1,2})/g,'$1年$2月$3日')).join('\n')
}

function esc(s=''){
return s.replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))
}

function renderPreview(k,d){
const p=document.querySelector('#pv');
const url=d.url&&/^https?:\/\//.test(d.url)?d.url:'#';
p.className='preview show';
p.innerHTML=`<div class="stage ${k}"><div class="stageIn"><div class="org">${esc(d.org||'劇団名')}</div><div class="title">${esc(d.title||'公演タイトル')}</div><div class="catch">${esc(d.catch||'作品を表す一言')}</div><div class="info"><div><b>SCHEDULE</b><span>${esc(fmtDate(d.date||'日程未入力'))}</span></div><div><b>VENUE</b><span>${esc(d.venue||'会場未入力')}</span></div><div><b>PRICE</b><span>${esc(d.price||'料金未入力')}</span></div><div><b>CAST</b><span>${esc(d.cast||'出演者未入力')}</span></div></div><div class="story">${esc(d.story||'ここにあらすじが入ります。')}</div><a class="ticket" href="${esc(url)}" target="_blank">TICKET / 予約</a></div></div>`;
p.scrollIntoView({behavior:'smooth',block:'start'})
}

if(mode&&T[mode])tpl(mode);else home();
</script>
</body>
</html>
